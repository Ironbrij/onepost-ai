{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ironbrij-onepost-ai",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  // main/assets/no_bundle/rules are deliberately omitted — Nitro
  // regenerates those per-preset (cloudflare-module locally vs
  // cloudflare-pages on Cloudflare's CF_PAGES=1 build machines) and
  // stale hardcoded paths here would silently ship a broken worker.
  //
  // VITE_FIREBASE_* are NOT listed here: they're only read via
  // import.meta.env at build time (baked into the client bundle), never
  // via process.env at Worker runtime, and are already provided as
  // build-time Secrets in the Cloudflare dashboard. Duplicating them
  // here creates a runtime binding with the same name and Cloudflare
  // refuses to deploy ("Binding name ... already in use").
  "vars": {
    "FIREBASE_PROJECT_ID": "onepost-88a95"
  }
}
