# Copy this file to .env.local for local dev (gitignored via *.local), and
# set the same values in Cloudflare Pages -> Settings -> Environment
# Variables (Production AND Preview) for deploys.

# --- Firebase Auth (client) ---
# From the Firebase Console: Project settings -> General -> Your apps ->
# SDK setup and configuration. These are NOT secrets — the Firebase Web SDK
# config is safe to ship to the browser (see src/lib/firebase.client.ts) —
# but they must use the VITE_ prefix so Vite includes them in the client
# bundle at all.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Auth (server) ---
# Same value as VITE_FIREBASE_PROJECT_ID above. Used server-side to verify
# the `iss`/`aud` claims on Firebase ID tokens (src/lib/auth.server.ts).
# Do NOT prefix with VITE_ — it doesn't need to reach the client, and the
# convention here is server-only vars stay unprefixed.
FIREBASE_PROJECT_ID=

# --- n8n webhook (existing) ---
N8N_WEBHOOK_URL=
